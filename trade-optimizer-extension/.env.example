# Copy to .env before `npm run build` / `npm run build:lib` to configure the paywall.
# Provider: none (everything free) | lemonsqueezy | remote (your own validate endpoint) | signed (keys you issue by hand)
VITE_PAYWALL_PROVIDER=lemonsqueezy
VITE_PAYWALL_PRODUCT=VegasLytics Trade Optimizer Pro

# Lemon Squeezy store subdomain: <store>.lemonsqueezy.com
VITE_PAYWALL_STORE=YOUR-STORE

# One variant per plan. Checkout URL = https://<store>.lemonsqueezy.com/checkout/buy/<variant>.
# If your store's buy links use a different identifier, set VITE_PAYWALL_CHECKOUT_<PLAN> to the full URL instead.
VITE_PAYWALL_VARIANT_WEEKEND=
VITE_PAYWALL_VARIANT_MONTHLY=
VITE_PAYWALL_VARIANT_SEASON=
VITE_PAYWALL_VARIANT_LIFETIME=
VITE_PAYWALL_PRICE_WEEKEND=$2.99
VITE_PAYWALL_PRICE_MONTHLY=$4.99
VITE_PAYWALL_PRICE_SEASON=$14.99
VITE_PAYWALL_PRICE_LIFETIME=$39
# One checkout link for every plan (e.g. a PayPal link where the buyer picks the pass).
# When set it is the only link the UI opens; variants and per-plan overrides are ignored.
VITE_PAYWALL_CHECKOUT=
# Plan the generic "Unlock all trades" buttons open.
VITE_PAYWALL_DEFAULT_PLAN=season

# Only for VITE_PAYWALL_PROVIDER=remote: POST {key, instanceId?, instanceName?} -> {valid, expiresAt?, email?, message?}
VITE_PAYWALL_VALIDATE=
# Only for VITE_PAYWALL_PROVIDER=signed: public key printed by `npm run license -- keygen`.
# Set VITE_PAYWALL_CHECKOUT (or VITE_PAYWALL_CHECKOUT_<PLAN>) to your payment link, then issue keys with `npm run license -- issue`.
VITE_PAYWALL_PUBLIC_KEY=
# Ranks shown in full without a license (comma-separated). The rest are teasers.
VITE_PAYWALL_FREE_RANKS=1

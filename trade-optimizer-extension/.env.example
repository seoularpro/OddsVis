# Copy to .env before `npm run build` to configure the paywall.
# Provider: none (everything free) | lemonsqueezy | remote (your own validate endpoint)
VITE_PAYWALL_PROVIDER=lemonsqueezy
VITE_PAYWALL_PRODUCT=OddsVis Trade Optimizer Pro
# Hosted checkout page opened by the Upgrade button.
VITE_PAYWALL_CHECKOUT=https://YOUR-STORE.lemonsqueezy.com/checkout/buy/YOUR-VARIANT-ID
# Only for VITE_PAYWALL_PROVIDER=remote: POST {key, instanceId?, instanceName?} -> {valid, expiresAt?, email?, message?}
VITE_PAYWALL_VALIDATE=
VITE_PAYWALL_PRICE=$4.99/mo
# Trades shown in full without a license.
VITE_PAYWALL_FREE_TRADES=1

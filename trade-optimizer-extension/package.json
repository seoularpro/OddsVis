{
  "name": "vegaslytics-trade-optimizer",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that analyzes the fantasy football league open in the browser and recommends the top 10 mutually beneficial trades that maximize the user's optimal starting-lineup median projection.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:ui && npm run build:content && npm run build:background",
    "build:ui": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build:background": "vite build --config vite.background.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs",
    "license": "node scripts/license.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/lib-banner.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}

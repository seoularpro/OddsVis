{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["chrome", "vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@oddsvis/*": ["../odds-react-app/src/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "vite.content.config.ts", "vite.background.config.ts", "vitest.config.ts"]
}
